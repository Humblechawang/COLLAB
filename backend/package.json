  "version": "1.0.0",
  "description": "API server for Collab — team portfolio platform",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",

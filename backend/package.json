    "file-type": "^22.1.1",
    "helmet": "^7.1.0",
    "isomorphic-dompurify": "^4.4.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
